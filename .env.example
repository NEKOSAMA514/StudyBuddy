# StudyBuddy 启动配置示例，可按需复制为 .env 后修改。
# 本机启动脚本和 Docker Compose 先读取本文件，再读取 .env 中的覆盖值。
# 页面已保存的对应设置优先于环境初值；修改本文件不会覆盖已保存设置或任务快照。
# 推荐在页面“设置 → API设置”中保存凭据；本文件及 .env 都是明文，不要提交真实密钥。

# Docker Compose 的本机访问端口；本机启动脚本使用 -Port 参数，默认同为 18000。
APP_PORT=18000

# 模型连接初值，与代码默认值一致。模型 ID 按服务商及账户实际可用列表填写。
# 使用其他兼容 Chat Completions 的服务时，同步修改地址、模型和 LLM_PROVIDER=openai-compatible。
# 服务费用与调用额度以服务商规则及账户状态为准。
LLM_PROVIDER=modelscope
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# 魔搭使用 MODELSCOPE_TOKEN，其他兼容服务使用 LLM_API_KEY；二选一，前者非空时优先。
MODELSCOPE_TOKEN=
LLM_API_KEY=
# 仅兼容旧设置，不再作为调用前置条件，也不表示已确认免费额度。
LLM_FREE_TIER_CONFIRMED=false

# 使用流式响应；仅在服务支持 response_format 时开启 JSON 模式，关闭后仍校验输出结构。
LLM_STREAM=true
LLM_JSON_MODE=false
# 分段模型请求并发数量，允许 1～4；可在页面设置中保存覆盖此初始值。
LLM_SECTION_CONCURRENCY=3

# 默认使用 CPU 和中文 Paraformer；模型需在设置页准备，环境变量不会自动下载权重。
# 使用 faster-whisper 时设置 ASR_ENGINE=whisper、ASR_MODEL=base 或 small，并按材料选择语言。
ASR_ENGINE=paraformer
ASR_MODEL=small
ASR_LANGUAGE=zh
# 识别线程数量，允许 1～16。
ASR_THREADS=4
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# 本地画面及文档图片文字识别；置信阈值允许 0～1。
OCR_ENGINE=rapidocr
OCR_MIN_CONFIDENCE=0.65

# 以下为 Docker Compose 挂载路径；本机启动脚本自动使用项目下的 models/ 和 log/。
# 直接运行 Python 时，按工作目录改为 ./models 和 ./log 或实际绝对路径。
MODEL_DIR=/models
LOG_DIR=/logs

# 仅供旧固定间隔任务和缓存兼容使用；新视频任务默认均匀抽取 60 帧。
FRAME_INTERVAL_SECONDS=15
# 上传上限按 MiB 计算，文档另受格式上限约束；视频最长时长以秒计。
MAX_UPLOAD_MB=2048
MAX_DURATION_SECONDS=7200
